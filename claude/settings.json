{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "5"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline/statusline.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline/subagent.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "agent-tree@claude-agent-tree": true,
    "syntax-cmd@claude-syntax-cmd": true,
    "plot-pane@claude-plot-pane": true
  },
  "extraKnownMarketplaces": {
    "claude-agent-tree": {
      "source": {
        "source": "github",
        "repo": "Lucasbk38/claude-agent-tree"
      }
    },
    "claude-syntax-cmd": {
      "source": {
        "source": "github",
        "repo": "Lucasbk38/claude-syntax-cmd"
      }
    },
    "claude-plot-pane": {
      "source": {
        "source": "github",
        "repo": "Lucasbk38/claude-plot-pane"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "askUserQuestionTimeout": "10m",
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "terminalProgressBarEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
