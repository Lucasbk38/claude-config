{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "5"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline/statusline.sh",
    "refreshInterval": 2
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline/subagent.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "agent-tree@claude-agent-tree": true,
    "syntax-cmd@claude-syntax-cmd": true,
    "plot-pane@claude-plot-pane": true
  },
  "extraKnownMarketplaces": {
    "claude-agent-tree": {
      "source": {
        "source": "github",
        "repo": "Lucasbk38/claude-agent-tree"
      }
    },
    "claude-syntax-cmd": {
      "source": {
        "source": "github",
        "repo": "Lucasbk38/claude-syntax-cmd"
      }
    },
    "claude-plot-pane": {
      "source": {
        "source": "github",
        "repo": "Lucasbk38/claude-plot-pane"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high",
      "autoCompactWindow": 300000
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "askUserQuestionTimeout": "10m",
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "terminalProgressBarEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/wiki/bin/register.sh start",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/wiki/bin/title.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/wiki/bin/register.sh end",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/wiki/bin/wait-clear.sh all",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/wiki/bin/stop.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/wiki/bin/wait-clear.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/wiki/bin/wait.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/wiki/bin/title.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "remoteControlAtStartup": true
}
